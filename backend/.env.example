# ─────────────────────────────────────────────────────────────────
# AHVAAN BACKEND — Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# USAGE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API

# Your project URL (looks like https://xxxx.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — safe for client-side, limited permissions
SUPABASE_ANON_KEY=your-anon-public-key-here

# Service Role key — full DB access, server-side ONLY, keep secret!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ── Server ───────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3001

# Environment: development | production
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────
# URL(s) of your frontend — comma-separated if multiple
# Example: http://localhost:5173,https://ahvaan.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ── Customization point ──────────────────────────────────────────
# Add any new environment variables below as your project grows.
# Example for future email notifications:
#   RESEND_API_KEY=your-resend-key
#   EMAIL_FROM=noreply@ahvaan.com
# ─────────────────────────────────────────────────────────────────
