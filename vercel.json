{
  "version": 2,
  "buildCommand": "cd apps/admin && npm install --include=dev && npm run build",
  "outputDirectory": "apps/admin/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
