{
  "version": 2,
  "buildCommand": "npm --prefix apps/admin install && npm --prefix apps/admin run build",
  "outputDirectory": "apps/admin/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
